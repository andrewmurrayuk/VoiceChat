@page
@model VoiceChat.Pages.IndexModel
@{
    ViewData["Title"] = "AI NativeFactory Voice Chat";
}

<div class="app">
    <header class="app-header">
        <div class="brand">
            <span class="brand-mark"></span>
            <h1 class="brand-name">AI NativeFactory Voice Chat</h1>
        </div>
        <p class="intro">
            Have a spoken, real-time conversation with an AI colleague who takes on a
            software delivery role. Choose a persona from the list and, if you like,
            <strong>attach a document</strong> for them to look at &mdash; a PDF, Word or
            PowerPoint file, or a source-code file. Press <strong>Start</strong> and simply
            talk; the AI listens and replies out loud, and a transcript builds up below as
            you go. Press <strong>End</strong> when you're finished, then use
            <strong>Copy</strong> or <strong>Download</strong> to keep the transcript.
        </p>
    </header>

    <section class="toolbar">
        <div class="toolbar-left">
            <label class="persona-select">
                <span class="persona-select-label">Persona</span>
                <select id="personaSelect" aria-label="Choose a persona"></select>
            </label>
            <button id="startBtn" class="btn btn-primary">Start</button>
            <button id="stopBtn" class="btn btn-secondary" disabled>End</button>
        </div>

        <div class="toolbar-right">
            <canvas id="visualizer" width="240" height="56" class="wave" aria-hidden="true"></canvas>
            <span id="speakerLabel" class="pill idle">Idle</span>
            <span id="status" class="status">Ready</span>
        </div>
    </section>

    <p id="personaDescription" class="persona-description"></p>

    <section class="attach-bar">
        <input type="file" id="fileInput" class="visually-hidden"
               accept=".pdf,.docx,.pptx,.txt,.md,.markdown,.csv,.tsv,.json,.yaml,.yml,.xml,.toml,.ini,.cs,.vb,.fs,.java,.kt,.go,.rs,.c,.h,.cpp,.hpp,.js,.jsx,.ts,.tsx,.py,.rb,.php,.swift,.sql,.sh,.ps1,.html,.css,.razor,.cshtml,.tf,.bicep,.csproj,.sln,.dockerfile" />
        <button id="attachBtn" class="btn btn-ghost btn-attach" title="Attach a document for the persona to analyse">
            <span class="attach-icon" aria-hidden="true">&#128206;</span> Attach document
        </button>
        <span id="attachStatus" class="attach-status"></span>
        <span id="attachedDoc" class="attached-doc" hidden>
            <span id="attachedDocName" class="attached-doc-name"></span>
            <span id="attachedDocMeta" class="attached-doc-meta"></span>
            <button id="removeDocBtn" class="attached-doc-remove" title="Remove document" aria-label="Remove document">&times;</button>
        </span>
    </section>

    <section class="transcript-card">
        <div class="transcript-header">
            <span class="transcript-title">Transcript</span>
            <div class="transcript-actions">
                <button id="copyBtn" class="btn btn-ghost" disabled title="Copy transcript to clipboard">Copy</button>
                <button id="downloadBtn" class="btn btn-ghost" disabled title="Download transcript as a text file">Download</button>
                <button id="clearBtn" class="btn btn-ghost" disabled title="Clear the transcript">Clear</button>
            </div>
        </div>
        <div id="transcript" class="transcript">
            <div class="transcript-placeholder">Your conversation will appear here.</div>
        </div>
    </section>

    <audio id="remoteAudio" autoplay playsinline></audio>
</div>

@section Scripts {
    <script src="~/js/realtime.js" asp-append-version="true"></script>
}
